{
  "name": "ahsan-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "next build && node --test --experimental-strip-types --import ./tests/ts-imports.mjs \"tests/**/*.test.mjs\"",
    "db:seed": "node --experimental-strip-types scripts/generate-seed-sql.mjs",
