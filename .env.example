# Copy to .env.local and fill in from your Supabase project:
# Project Settings → API.
#
# Both are meant to be public — the anon key is what the browser would use, and
# the row level security policies in supabase/migrations/ are what actually
# guard the data. Never put the service_role key here; it bypasses every policy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The site's public address. Used for confirmation-email links, canonical URLs,
# the sitemap, and share cards. Leave unset locally and the current request's
# origin is used.
#
# Setting this is only half the job: Supabase ignores a redirect it was not told
# to trust, and silently falls back to its own Site URL instead. In the Supabase
# dashboard, under Authentication → URL Configuration, set Site URL to the same
# address and add it to Redirect URLs (with /** on the end), alongside
# http://localhost:3000/** for local work.
# NEXT_PUBLIC_SITE_URL=https://ahsanproject.id
